<?xml version="1.0"?>
<package format="3">
  <name>slam</name>
  <version>0.1.0</version>
  <description>SLAM and navigation configuration for the quadruped robot.</description>
  <maintainer email="developer@example.com">Quadruped Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>quadruped_description</exec_depend>
  <exec_depend>quadruped_perception</exec_depend>
  <exec_depend>quadruped_planning</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
