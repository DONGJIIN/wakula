<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wakula_quadruped">
  <!-- 仅用于 RViz 外形预览和传感器 TF 占位；尺寸、惯量与关节范围均未真机标定。
       本文件不包含 ros2_control、驱动插件、运动学或动力学控制实现。 -->
  <xacro:property name="body_length" value="0.52"/>
  <xacro:property name="body_width" value="0.24"/>
  <xacro:property name="body_height" value="0.12"/>
  <xacro:property name="hip_length" value="0.065"/>
  <xacro:property name="upper_leg_length" value="0.22"/>
  <xacro:property name="lower_leg_length" value="0.23"/>
  <xacro:property name="leg_radius" value="0.025"/>
  <xacro:property name="foot_radius" value="0.035"/>

  <material name="wakula_blue"><color rgba="0.06 0.28 0.62 1"/></material>
  <material name="joint_gray"><color rgba="0.22 0.25 0.29 1"/></material>
  <material name="leg_silver"><color rgba="0.68 0.72 0.76 1"/></material>
  <material name="foot_black"><color rgba="0.04 0.04 0.04 1"/></material>
  <material name="sensor_black"><color rgba="0.08 0.08 0.09 1"/></material>

  <xacro:macro name="box_inertial" params="mass x y z ox:=0 oy:=0 oz:=0">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
               iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
               izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${0.4 * mass * radius * radius}" ixy="0" ixz="0"
               iyy="${0.4 * mass * radius * radius}" iyz="0"
               izz="${0.4 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <!-- base_footprint remains on the nominal ground plane for navigation. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.44"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="wakula_blue"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <xacro:box_inertial mass="12.0" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <!-- side is +1 for left legs and -1 for right legs. -->
  <xacro:macro name="leg" params="prefix x y side">
    <link name="${prefix}_hip_link">
      <visual>
        <origin xyz="0 ${side * hip_length / 2.0} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${hip_length}"/></geometry>
        <material name="joint_gray"/>
      </visual>
      <collision>
        <origin xyz="0 ${side * hip_length / 2.0} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${hip_length}"/></geometry>
      </collision>
      <xacro:box_inertial mass="0.55" x="${2*leg_radius}" y="${hip_length}"
                           z="${2*leg_radius}" oy="${side * hip_length / 2.0}"/>
    </link>
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_link"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.75" upper="0.75" effort="80" velocity="8"/>
      <dynamics damping="0.2" friction="0.05"/>
    </joint>

    <link name="${prefix}_upper_leg">
      <visual>
        <origin xyz="0 0 ${-upper_leg_length/2.0}"/>
        <geometry><cylinder radius="${leg_radius}" length="${upper_leg_length}"/></geometry>
        <material name="leg_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-upper_leg_length/2.0}"/>
        <geometry><cylinder radius="${leg_radius}" length="${upper_leg_length}"/></geometry>
      </collision>
      <xacro:box_inertial mass="1.0" x="${2*leg_radius}" y="${2*leg_radius}"
                           z="${upper_leg_length}" oz="${-upper_leg_length/2.0}"/>
    </link>
    <joint name="${prefix}_thigh_joint" type="revolute">
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_upper_leg"/>
      <origin xyz="0 ${side * hip_length} 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.20" effort="120" velocity="10"/>
      <dynamics damping="0.25" friction="0.05"/>
    </joint>

    <link name="${prefix}_lower_leg">
      <visual>
        <origin xyz="0 0 ${-lower_leg_length/2.0}"/>
        <geometry><cylinder radius="${leg_radius * 0.8}" length="${lower_leg_length}"/></geometry>
        <material name="leg_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-lower_leg_length/2.0}"/>
        <geometry><cylinder radius="${leg_radius * 0.8}" length="${lower_leg_length}"/></geometry>
      </collision>
      <xacro:box_inertial mass="0.65" x="${1.6*leg_radius}" y="${1.6*leg_radius}"
                           z="${lower_leg_length}" oz="${-lower_leg_length/2.0}"/>
    </link>
    <joint name="${prefix}_calf_joint" type="revolute">
      <parent link="${prefix}_upper_leg"/>
      <child link="${prefix}_lower_leg"/>
      <origin xyz="0 0 ${-upper_leg_length}"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.70" upper="-0.15" effort="120" velocity="10"/>
      <dynamics damping="0.25" friction="0.05"/>
    </joint>

    <link name="${prefix}_foot">
      <visual>
        <geometry><sphere radius="${foot_radius}"/></geometry>
        <material name="foot_black"/>
      </visual>
      <collision><geometry><sphere radius="${foot_radius}"/></geometry></collision>
      <xacro:sphere_inertial mass="0.12" radius="${foot_radius}"/>
    </link>
    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_lower_leg"/>
      <child link="${prefix}_foot"/>
      <origin xyz="0 0 ${-lower_leg_length}"/>
    </joint>
  </xacro:macro>

  <xacro:leg prefix="front_left"  x="0.20"  y="${body_width/2.0}"  side="1"/>
  <xacro:leg prefix="front_right" x="0.20"  y="${-body_width/2.0}" side="-1"/>
  <xacro:leg prefix="rear_left"   x="-0.20" y="${body_width/2.0}"  side="1"/>
  <xacro:leg prefix="rear_right"  x="-0.20" y="${-body_width/2.0}" side="-1"/>

  <!-- Sensor frames used by SLAM and terrain-perception nodes. -->
  <link name="imu_link">
    <visual><geometry><box size="0.04 0.03 0.015"/></geometry><material name="sensor_black"/></visual>
    <xacro:box_inertial mass="0.03" x="0.04" y="0.03" z="0.015"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.065"/>
  </joint>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.045" length="0.04"/></geometry><material name="sensor_black"/></visual>
    <xacro:box_inertial mass="0.18" x="0.09" y="0.09" z="0.04"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <!-- Nominal top-center reservation; replace with measured scan-center TF. -->
    <parent link="base_link"/><child link="lidar_link"/><origin xyz="0.04 0 0.12"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.04 0.09 0.035"/></geometry><material name="sensor_black"/></visual>
    <xacro:box_inertial mass="0.09" x="0.04" y="0.09" z="0.035"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <!-- Nominal front-center reservation with 12-degree downward pitch. -->
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.29 0 0.03" rpy="0 ${12*pi/180} 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

</robot>
