<?xml version="1.0"?>
<package format="3">
  <name>slam</name>
  <version>0.1.0</version>
  <description>SLAM and navigation configuration for the quadruped robot.</description>
  <maintainer email="developer@example.com">Quadruped Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>quadruped_bringup</exec_depend>
  <exec_depend>quadruped_planning</exec_depend>
  <!-- 仅供 autonomous_navigation.launch.py 在仿真时选择测试 Action 后端；
       核心 slam.launch.py 不启动或依赖任何 Gazebo 进程。 -->
  <exec_depend>quadruped_gazebo</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2lifecycle</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
