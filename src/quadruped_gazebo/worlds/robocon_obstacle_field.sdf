        <visual name="bar_10"><pose>0 0.45 0.32 1.570796 0 0</pose><geometry><cylinder><radius>0.021</radius><length>0.10</length></cylinder></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- LAYOUT 4/8：大斜坡。规则尺寸为长 3.00 m、总宽 2.00 m、坡角 10°。 -->
    <model name="main_slope">
      <static>true</static>
      <pose relative_to="layout_main_slope">0 0 0 0 0 0</pose>
      <link name="slope">
        <!-- 3 m 斜面高差约 0.521 m；薄板中心高度按几何计算。 -->
        <collision name="ramp"><pose>0 0 0.265 0 -0.174533 0</pose><geometry><box><size>3.00 2.00 0.08</size></box></geometry></collision>
        <visual name="visual_ramp"><pose>0 0 0.265 0 -0.174533 0</pose><geometry><box><size>3.00 2.00 0.08</size></box></geometry><material><ambient>0.874510 0.458824 0 1</ambient><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- LAYOUT 5/8：木桥 A。规则图：跨段 1.50 m，三条并行桥条各宽 0.10 m；平台高 0.20 m。 -->
    <model name="wooden_bridge_a">
      <static>true</static>
      <pose relative_to="layout_wooden_bridge_a">0 0 0 0 0 0</pose>
      <link name="bridge_a">
        <collision name="start_platform"><pose>-1.25 0 0.10 0 0 0</pose><geometry><box><size>1.00 1.00 0.20</size></box></geometry></collision>
        <collision name="finish_platform"><pose>1.25 0 0.10 0 0 0</pose><geometry><box><size>1.00 1.00 0.20</size></box></geometry></collision>
        <collision name="beam_1"><pose>0 -0.20 0.15 0 0 0</pose><geometry><box><size>1.50 0.10 0.10</size></box></geometry></collision>
        <collision name="beam_2"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>1.50 0.10 0.10</size></box></geometry></collision>
        <collision name="beam_3"><pose>0 0.20 0.15 0 0 0</pose><geometry><box><size>1.50 0.10 0.10</size></box></geometry></collision>
        <!-- 两座木桥共两条上下平台小坡：A 使用入口坡，14°、平台高 0.20 m。 -->
        <collision name="approach_ramp"><pose>-2.151 0 0.10 0 -0.244346 0</pose><geometry><box><size>0.827 1.00 0.05</size></box></geometry></collision>
        <visual name="visual_start_platform"><pose>-1.25 0 0.10 0 0 0</pose><geometry><box><size>1.00 1.00 0.20</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_finish_platform"><pose>1.25 0 0.10 0 0 0</pose><geometry><box><size>1.00 1.00 0.20</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_beam_1"><pose>0 -0.20 0.15 0 0 0</pose><geometry><box><size>1.50 0.10 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_beam_2"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>1.50 0.10 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_beam_3"><pose>0 0.20 0.15 0 0 0</pose><geometry><box><size>1.50 0.10 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_approach_ramp"><pose>-2.151 0 0.10 0 -0.244346 0</pose><geometry><box><size>0.827 1.00 0.05</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- LAYOUT 6/8：木桥 B。规则图：跨段 2.90 m，六块 0.15 m 桥板，净间隔 0.40 m。 -->
    <model name="wooden_bridge_b">
      <static>true</static>
      <pose relative_to="layout_wooden_bridge_b">0 0 0 0 0 0</pose>
      <link name="bridge_b">
        <collision name="start"><pose>-1.95 0 0.10 0 0 0</pose><geometry><box><size>1.00 1.00 0.20</size></box></geometry></collision>
        <collision name="finish"><pose>1.95 0 0.10 0 0 0</pose><geometry><box><size>1.00 1.00 0.20</size></box></geometry></collision>
