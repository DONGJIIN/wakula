        <collision name="right_3"><pose>0.65 0 0.15 0 0 0</pose><geometry><box><size>0.30 1.00 0.30</size></box></geometry></collision>
        <collision name="right_2"><pose>0.95 0 0.10 0 0 0</pose><geometry><box><size>0.30 1.00 0.20</size></box></geometry></collision>
        <collision name="right_1"><pose>1.25 0 0.05 0 0 0</pose><geometry><box><size>0.30 1.00 0.10</size></box></geometry></collision>
        <!-- T 字纵向一臂再延伸 0.90 m，使总宽为 1.90 m。 -->
        <collision name="stem_3"><pose>0 -0.65 0.15 0 0 0</pose><geometry><box><size>1.00 0.30 0.30</size></box></geometry></collision>
        <collision name="stem_2"><pose>0 -0.95 0.10 0 0 0</pose><geometry><box><size>1.00 0.30 0.20</size></box></geometry></collision>
        <collision name="stem_1"><pose>0 -1.25 0.05 0 0 0</pose><geometry><box><size>1.00 0.30 0.10</size></box></geometry></collision>
        <visual name="visual_left_3"><pose>-0.65 0 0.15 0 0 0</pose><geometry><box><size>0.30 1.00 0.30</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_left_2"><pose>-0.95 0 0.10 0 0 0</pose><geometry><box><size>0.30 1.00 0.20</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_left_1"><pose>-1.25 0 0.05 0 0 0</pose><geometry><box><size>0.30 1.00 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_right_3"><pose>0.65 0 0.15 0 0 0</pose><geometry><box><size>0.30 1.00 0.30</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_right_2"><pose>0.95 0 0.10 0 0 0</pose><geometry><box><size>0.30 1.00 0.20</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
