        <collision name="plank_4"><pose>0.275 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry></collision>
        <collision name="plank_5"><pose>0.825 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry></collision>
        <collision name="plank_6"><pose>1.375 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry></collision>
        <!-- B 使用出口坡；水平投影约 0.802 m，斜面长度约 0.827 m，倾角严格为 14°。 -->
        <collision name="approach_ramp"><pose>2.851 0 0.10 0 0.244346 0</pose><geometry><box><size>0.827 1.00 0.05</size></box></geometry></collision>
        <visual name="visual_plank_1"><pose>-1.375 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_plank_2"><pose>-0.825 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_plank_3"><pose>-0.275 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_plank_4"><pose>0.275 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_plank_5"><pose>0.825 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_plank_6"><pose>1.375 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_approach_ramp"><pose>2.851 0 0.10 0 0.244346 0</pose><geometry><box><size>0.827 1.00 0.05</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- LAYOUT 7/8：T 字形台阶。总长 2.80 m、总宽 1.90 m、平台高 0.40 m。 -->
    <model name="t_shaped_stairs">
      <static>true</static>
      <pose relative_to="layout_t_shaped_stairs">0 0 0 0 0 0</pose>
      <link name="stairs">
        <collision name="platform"><pose>0 0 0.20 0 0 0</pose><geometry><box><size>1.00 1.00 0.40</size></box></geometry></collision>
