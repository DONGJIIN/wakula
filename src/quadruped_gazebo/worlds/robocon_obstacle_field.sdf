        <visual name="steel_cap"><pose>0 0 0.285 0 0 0</pose><geometry><box><size>0.055 1.01 0.03</size></box></geometry><material><ambient>0.42 0.44 0.46 1</ambient><diffuse>0.60 0.62 0.65 1</diffuse><specular>0.85 0.85 0.85 1</specular></material></visual>
