        <!-- 左右各 0.90 m，三级台阶：踏面 0.30 m、级高 0.10 m。 -->
        <collision name="left_3"><pose>-0.65 0 0.15 0 0 0</pose><geometry><box><size>0.30 1.00 0.30</size></box></geometry></collision>
        <collision name="left_2"><pose>-0.95 0 0.10 0 0 0</pose><geometry><box><size>0.30 1.00 0.20</size></box></geometry></collision>
