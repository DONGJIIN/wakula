        <visual name="visual_stem_3"><pose>0 -0.65 0.15 0 0 0</pose><geometry><box><size>1.00 0.30 0.30</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_stem_2"><pose>0 -0.95 0.10 0 0 0</pose><geometry><box><size>1.00 0.30 0.20</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <visual name="visual_stem_1"><pose>0 -1.25 0.05 0 0 0</pose><geometry><box><size>1.00 0.30 0.10</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <!-- 顶部 1×1 m 可选启动区：红色虚线用四条细线近似，只有 visual。 -->
        <visual name="start_n"><pose>0 0.47 0.405 0 0 0</pose><geometry><box><size>0.92 0.025 0.01</size></box></geometry><material><diffuse>0.85 0.03 0.03 1</diffuse></material></visual>
        <visual name="start_s"><pose>0 -0.47 0.405 0 0 0</pose><geometry><box><size>0.92 0.025 0.01</size></box></geometry><material><diffuse>0.85 0.03 0.03 1</diffuse></material></visual>
        <visual name="start_e"><pose>0.47 0 0.405 0 0 0</pose><geometry><box><size>0.025 0.92 0.01</size></box></geometry><material><diffuse>0.85 0.03 0.03 1</diffuse></material></visual>
        <visual name="start_w"><pose>-0.47 0 0.405 0 0 0</pose><geometry><box><size>0.025 0.92 0.01</size></box></geometry><material><diffuse>0.85 0.03 0.03 1</diffuse></material></visual>
      </link>
    </model>

    <!-- LAYOUT 8/8：高墙。长 1.00 m、高 0.30 m、厚 0.05 m，橘色墙体、顶部钢色。 -->
    <model name="high_wall">
      <static>true</static>
      <pose relative_to="layout_high_wall">0 0 0 0 0 0</pose>
      <link name="wall">
