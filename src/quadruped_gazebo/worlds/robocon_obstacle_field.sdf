         起点错位。默认机头朝西，远离主斜坡侧边；该朝向只属于 Gazebo 参考布局。 -->
    <model name="ground_start_zone_reference">
      <static>true</static><pose>-2.50 -0.20 0 0 0 0</pose>
      <link name="outline">
        <visual name="n"><pose>0 0.49 0.004 0 0 0</pose><geometry><box><size>1 0.025 0.008</size></box></geometry><material><diffuse>0.85 0.03 0.03 1</diffuse></material></visual>
        <visual name="s"><pose>0 -0.49 0.004 0 0 0</pose><geometry><box><size>1 0.025 0.008</size></box></geometry><material><diffuse>0.85 0.03 0.03 1</diffuse></material></visual>
        <visual name="e"><pose>0.49 0 0.004 0 0 0</pose><geometry><box><size>0.025 1 0.008</size></box></geometry><material><diffuse>0.85 0.03 0.03 1</diffuse></material></visual>
