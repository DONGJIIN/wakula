        <visual name="visual_finish"><pose>1.95 0 0.10 0 0 0</pose><geometry><box><size>1.00 1.00 0.20</size></box></geometry><material><diffuse>0.874510 0.458824 0 1</diffuse></material></visual>
        <collision name="plank_1"><pose>-1.375 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry></collision>
        <collision name="plank_2"><pose>-0.825 0 0.15 0 0 0</pose><geometry><box><size>0.15 1.00 0.10</size></box></geometry></collision>
