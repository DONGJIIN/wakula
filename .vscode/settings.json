  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}/build/slam",
    "${workspaceFolder}/install/slam/lib/python3.12/site-packages",
    "${workspaceFolder}/build/quadruped_bringup",
    "${workspaceFolder}/install/quadruped_bringup/lib/python3.12/site-packages",
    "${workspaceFolder}/build/quadruped_planning",
