{
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "cmake.configureOnOpen": false,
  "files.associations": {
    "*.xacro": "xml",
    "*.urdf": "xml"
  },
  "terminal.integrated.env.linux": {
    "ROS_DISTRO": "jazzy",
    "LD_LIBRARY_PATH": null,
    "SNAP": null,
    "SNAP_ARCH": null,
    "SNAP_COMMON": null,
