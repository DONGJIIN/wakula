    "SNAP_UID": null,
    "SNAP_USER_COMMON": null,
    "SNAP_USER_DATA": null,
    "SNAP_VERSION": null,
    "GTK_EXE_PREFIX": null,
    "GTK_PATH": null,
    "GDK_PIXBUF_MODULEDIR": null,
    "GDK_PIXBUF_MODULE_FILE": null,
    "GIO_MODULE_DIR": null,
    "GSETTINGS_SCHEMA_DIR": null,
