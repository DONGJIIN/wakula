#!/usr/bin/env bash
set -eo pipefail

# 自主导航纯控制入口。
#
# 本脚本绝不启动 SLAM、Gazebo 或后台进程，只调用 slam.launch.py 中已装载的任务节点。
# 开关状态由 autonomous_mission 节点原子维护，所以每次执行都可靠地在 START/STOP 间切换。

workspace_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source /opt/ros/jazzy/setup.bash

if [[ ! -f "${workspace_dir}/install/setup.bash" ]]; then
  echo "尚未编译工作空间，请先运行：cd ${workspace_dir} && ./scripts/build.sh" >&2
  exit 1
fi
source "${workspace_dir}/install/setup.bash"

echo "正在切换自主导航……"
if ! response="$(timeout 10 ros2 service call \
    /autonomy/toggle std_srvs/srv/Trigger "{}" 2>&1)"; then
  echo "${response}" >&2
  echo "未找到自主导航节点。请先运行：ros2 launch slam slam.launch.py" >&2
  exit 1
fi

echo "${response}"
if ! grep -F "success=True" <<<"${response}" >/dev/null; then
  echo "自主导航节点拒绝切换，请检查上方原因。" >&2
  exit 1
fi
